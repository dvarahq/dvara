<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dvarahq</groupId>
        <artifactId>dvara-platform</artifactId>
        <version>1.17.0-SNAPSHOT</version>
    </parent>

    <artifactId>dvara-providers</artifactId>
    <name>dvara-providers</name>
    <description>DVARA Providers – the provider adapters (OpenAI, Anthropic, Gemini, Bedrock, Vertex AI and the others) and the mock provider, as a library with no auto-configuration</description>

    <dependencies>
        <dependency>
            <groupId>com.dvarahq</groupId>
            <artifactId>dvara-gateway-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- RestClient, the HTTP client every adapter calls its provider with. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- The mock provider's scenario scripts and matchers. -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Three tests stand in an incoming request with Spring's MockHttpServletRequest. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- StalledStreamReleaseTest reads a stream through Apache HttpClient. -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
