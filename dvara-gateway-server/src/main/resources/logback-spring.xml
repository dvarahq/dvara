<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="logback-dvara.xml"/>

    <springProfile name="log-plain">
        <root level="INFO">
            <appender-ref ref="PLAIN_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!log-plain">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

</configuration>
